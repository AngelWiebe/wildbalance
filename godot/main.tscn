theme_override_colors/font_outline_color = Color(0.01, 0.02, 0.015, 0.9)
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 16
text = "YOU ARE THE FOREST STEWARD\n\nBalance four seasons to complete the run. Hold balance above 70% for 60 seconds and tend two different meadows every season. You have three reseeds per season.\n\nYOUR TOOLS\n1–8  Reseed a low-food meadow.\n−/=  Set the herd target (2–6 deer).\n[/]  Set the pack target (1–2 wolves).\nQ  Scare a hunting wolf (18-second cooldown).\nT  Start a fresh stewardship run.\n\nEXPLORE\nWASD  Pan. Right-drag  Look. Scroll  Zoom.\nV  Toggle free-fly: WASD moves, Space rises, Shift descends, scroll changes speed.\nF  Follow a deer. R  Reset the camera. H  Hide the HUD.\n\nSEASONAL EVENTS\nSpring and autumn restore food quickly. Summer dry spells and winter frost make early reseeding essential."
autowrap_mode = 2

